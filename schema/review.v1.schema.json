{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-memory.local/schema/review.v1",
  "title": "Common Memory Review v1",
  "oneOf": [
    {
      "$ref": "#/$defs/approved"
    },
    {
      "$ref": "#/$defs/rejected"
    }
  ],
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "global"
            },
            "id": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "project",
                "agent",
                "device"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^:\\s]+$"
            }
          }
        }
      ]
    },
    "suggested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "kind",
        "scope",
        "priority",
        "valid_from",
        "expires_at",
        "tags"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "kind": {
          "enum": [
            "identity",
            "goal",
            "preference",
            "constraint",
            "environment",
            "relationship",
            "decision",
            "event"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "priority": {
          "enum": [
            "core",
            "normal",
            "archive"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "proposal_id",
        "decision",
        "reviewed_at",
        "reviewer",
        "note",
        "based_on_store_revision",
        "execution"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^review\\.[A-Za-z0-9_-]{8,128}$"
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^proposal\\.[A-Za-z0-9_-]{8,128}$"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "local_user",
                "memory_manager_policy"
              ]
            }
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "based_on_store_revision": {
          "$ref": "#/$defs/revision"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        }
      }
    },
    "final": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "suggested_fact",
            "resulting_fact_ids"
          ],
          "properties": {
            "operation": {
              "const": "add_fact"
            },
            "suggested_fact": {
              "$ref": "#/$defs/suggested"
            },
            "resulting_fact_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "pattern": "^fact\\.[A-Za-z0-9_-]{8,128}$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "target_fact_ids",
            "suggested_fact",
            "resulting_fact_ids"
          ],
          "properties": {
            "operation": {
              "const": "supersede_fact"
            },
            "target_fact_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^fact\\.[A-Za-z0-9_-]{8,128}$"
              }
            },
            "suggested_fact": {
              "$ref": "#/$defs/suggested"
            },
            "resulting_fact_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "pattern": "^fact\\.[A-Za-z0-9_-]{8,128}$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "target_fact_ids",
            "expires_at",
            "reason",
            "resulting_fact_ids"
          ],
          "properties": {
            "operation": {
              "const": "expire_fact"
            },
            "target_fact_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^fact\\.[A-Za-z0-9_-]{8,128}$"
              }
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "resulting_fact_ids": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    "approved": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "final_operation",
            "resulting_store_revision"
          ],
          "properties": {
            "decision": {
              "const": "approved"
            },
            "final_operation": {
              "$ref": "#/$defs/final"
            },
            "resulting_store_revision": {
              "$ref": "#/$defs/revision"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rejected": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "rejected"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "execution": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "batch_id",
            "operation_id",
            "sequence",
            "batch_size",
            "intent",
            "policy_version",
            "source_digest",
            "base_knowledge_revision",
            "base_store_revision",
            "payload_digest",
            "reverts_review_ids"
          ],
          "properties": {
            "mode": {
              "enum": [
                "extract",
                "consolidate",
                "compensation"
              ]
            },
            "batch_id": {
              "type": "string",
              "pattern": "^batch\\.[a-f0-9]{64}$"
            },
            "operation_id": {
              "type": "string",
              "pattern": "^operation\\.[a-f0-9]{64}$"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "intent": {
              "enum": [
                "add",
                "modify",
                "replace",
                "merge",
                "distill",
                "expire",
                "archive"
              ]
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "source_digest": {
              "$ref": "#/$defs/revision"
            },
            "base_knowledge_revision": {
              "$ref": "#/$defs/revision"
            },
            "base_store_revision": {
              "$ref": "#/$defs/revision"
            },
            "payload_digest": {
              "$ref": "#/$defs/revision"
            },
            "reverts_review_ids": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 100,
              "items": {
                "type": "string",
                "pattern": "^review\\.[A-Za-z0-9_-]{8,128}$"
              }
            }
          }
        }
      ]
    }
  }
}
