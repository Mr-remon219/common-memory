        },
        "statement": {
          "type": "null"
        },
        "kind": {
          "type": "null"
        },
        "scope": {
          "type": "null"
        },
        "priority": {
          "type": "null"
        },
        "target_fact_ids": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "null"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
