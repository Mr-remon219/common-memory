{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-memory.local/schema/memory-analysis.v1",
  "title": "MemoryAnalysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "based_on_knowledge_revision",
    "based_on_store_revision",
    "actions",
    "abstained_reason_codes"
  ],
  "properties": {
    "contract_version": {
      "enum": [
        "memory_analysis_v1"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "based_on_knowledge_revision": {
      "$ref": "#/$defs/revision"
    },
    "based_on_store_revision": {
      "$ref": "#/$defs/revision"
    },
    "actions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/add"
          },
          {
            "$ref": "#/$defs/modify"
          },
          {
            "$ref": "#/$defs/replace"
          },
          {
            "$ref": "#/$defs/merge"
          },
          {
            "$ref": "#/$defs/distill"
          },
          {
            "$ref": "#/$defs/expire"
          },
          {
            "$ref": "#/$defs/archive"
          },
          {
            "$ref": "#/$defs/no_op"
          }
        ]
      }
    },
    "abstained_reason_codes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "kind": {
      "enum": [
        "identity",
        "goal",
        "preference",
        "constraint",
        "environment",
        "relationship",
        "decision",
        "event"
      ]
    },
    "priority": {
      "enum": [
        "core",
        "normal",
        "archive"
      ]
    },
    "nullable_string": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "string_array": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    },
    "add": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
        "expires_at",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "add"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "statement": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "target_fact_ids": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "tags": {
          "$ref": "#/$defs/string_array"
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "modify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
        "expires_at",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "modify"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "statement": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "target_fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "tags": {
          "$ref": "#/$defs/string_array"
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
        "expires_at",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "replace"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "statement": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "target_fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "tags": {
          "$ref": "#/$defs/string_array"
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
        "expires_at",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "merge"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "statement": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "target_fact_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "tags": {
          "$ref": "#/$defs/string_array"
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "distill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
        "expires_at",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "distill"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "statement": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "target_fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "tags": {
          "$ref": "#/$defs/string_array"
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "expire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
        "expires_at",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "expire"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "statement": {
          "type": "null"
        },
        "kind": {
          "type": "null"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "type": "null"
        },
        "target_fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "tags": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
        "expires_at",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "archive"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "statement": {
          "type": "null"
        },
        "kind": {
          "type": "null"
        },
        "scope": {
          "type": "string"
        },
        "priority": {
          "type": "null"
        },
        "target_fact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/string_array"
        },
        "tags": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "null"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "no_op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "confidence",
        "statement",
        "kind",
        "scope",
        "priority",
        "target_fact_ids",
        "evidence_refs",
        "tags",
