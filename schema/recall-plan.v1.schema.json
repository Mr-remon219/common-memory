{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-memory.local/schema/recall-plan.v1",
  "title": "Recall Route Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "based_on_knowledge_revision",
    "mode",
    "queries",
    "reason"
  ],
  "properties": {
    "contract_version": { "enum": ["recall_plan_v1"] },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "based_on_knowledge_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "mode": { "enum": ["algorithm", "hybrid", "model_led"] },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "reason": { "type": "string", "maxLength": 2000 }
  }
}
