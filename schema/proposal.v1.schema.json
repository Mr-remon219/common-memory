{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-memory.local/schema/proposal.v1",
  "title": "Common Memory Proposal v1",
  "oneOf": [
    {
      "$ref": "#/$defs/add"
    },
    {
      "$ref": "#/$defs/supersede"
    },
    {
      "$ref": "#/$defs/expire"
    }
  ],
  "$defs": {
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "global"
            },
            "id": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "project",
                "agent",
                "device"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^:\\s]+$"
            }
          }
        }
      ]
    },
    "suggested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "kind",
        "scope",
        "priority",
        "valid_from",
        "expires_at",
        "tags"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "kind": {
          "enum": [
            "identity",
            "goal",
            "preference",
            "constraint",
            "environment",
            "relationship",
            "decision",
            "event"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "priority": {
          "enum": [
            "core",
            "normal",
            "archive"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_type",
        "session_id",
        "reference",
        "observed_at"
      ],
      "properties": {
        "provenance_type": {
          "enum": [
            "user_statement",
            "user_correction",
            "agent_observation",
            "imported_event",
            "project_evidence"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "operation",
        "target_fact_ids",
        "evidence",
        "reasoning",
        "confidence",
        "source",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^proposal\\.[A-Za-z0-9_-]{8,128}$"
        },
        "operation": {
          "enum": [
            "add_fact",
            "supersede_fact",
            "expire_fact"
          ]
        },
        "target_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^fact\\.[A-Za-z0-9_-]{8,128}$"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reasoning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client",
            "received_at"
          ],
          "properties": {
            "client": {
              "enum": [
                "local_user",
                "memory_manager"
              ]
            },
            "received_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "add": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "suggested_fact"
          ],
          "properties": {
            "operation": {
              "const": "add_fact"
            },
            "target_fact_ids": {
              "type": "array",
              "maxItems": 0
            },
            "suggested_fact": {
              "$ref": "#/$defs/suggested"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "supersede": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "suggested_fact"
          ],
          "properties": {
            "operation": {
              "const": "supersede_fact"
            },
            "target_fact_ids": {
              "type": "array",
              "minItems": 1
            },
            "suggested_fact": {
              "$ref": "#/$defs/suggested"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "expire": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "required": [
            "suggested_expiration"
          ],
          "properties": {
            "operation": {
              "const": "expire_fact"
            },
            "target_fact_ids": {
              "type": "array",
              "minItems": 1
            },
            "suggested_expiration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "expires_at",
                "reason"
              ],
              "properties": {
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
