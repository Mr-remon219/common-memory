{
  "name": "common-memory-core",
  "version": "0.2.1",
  "license": "MIT",
  "description": "User-owned Markdown memory with durable maintenance, Pi integration and local stdio MCP access.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-remon219/common-memory.git"
  },
  "homepage": "https://github.com/Mr-remon219/common-memory#readme",
  "bugs": {
    "url": "https://github.com/Mr-remon219/common-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "memory",
    "agent-memory"
  ],
  "bin": {
    "common-memory": "./dist/cli/main.js"
  },
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".env.sample",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension/index.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:fixtures": "vitest run tests/v2",
    "test:recovery": "vitest run tests/v2",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:published": "node scripts/consumer-smoke.mjs --registry-version 0.2.1",
    "test:remote-contract": "vitest run tests/memory-manager",
    "prepack": "npm run build",
    "release:check": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run release:check && npm run verify && npm run test:consumer",
    "verify": "node scripts/verify.mjs",
    "evaluate:v2": "npm run build && node scripts/evaluate-v2.mjs",
    "ablate:v2": "npm run build && node scripts/ablate-v2.mjs --output=docs/v2-ablation-results.json",
    "benchmark:v2": "npm run build && node scripts/benchmark-v2.mjs",
    "test:provider-smoke": "node --test tests/scripts/provider-smoke.integration.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.17.1",
    "typebox": "1.3.7",
    "undici": "8.10.2",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
