{
  "name": "common-memory-core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "memory",
    "agent-memory"
  ],
  "bin": {
    "common-memory": "./dist/cli/main.js"
  },
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".env.sample",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension/index.js"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:fixtures": "vitest run tests/v2",
    "test:recovery": "vitest run tests/v2",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:remote-contract": "vitest run tests/memory-manager",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "evaluate:v2": "npm run build && node scripts/evaluate-v2.mjs",
    "ablate:v2": "npm run build && node scripts/ablate-v2.mjs --output=docs/v2-ablation-results.json",
    "benchmark:v2": "npm run build && node scripts/benchmark-v2.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
