{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-writer-benchmark.dev/schema/writer-card.v1.schema.json",
  "title": "MWB WriterCard v1",
  "description": "Exact identity of one evaluated writer. A system name alone is never a writer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "writer_id",
    "display_name",
    "kind",
    "component_surface",
    "source",
    "admission",
    "backend",
    "capacity_control",
    "export_adapter",
    "quiescence",
    "memory_surface"
  ],
  "properties": {
    "spec_version": { "type": "string", "const": "0.1" },
    "writer_id": { "type": "string", "pattern": "^writer\\.[a-z0-9_]+$" },
    "display_name": { "type": "string" },
    "kind": { "type": "string", "enum": ["external_system", "baseline", "academic_baseline", "experimental_variant"] },
    "component_surface": {
      "type": "string",
      "description": "Which concrete write path is under test, e.g. 'built-in curated MEMORY.md/USER.md', 'fact extraction lane'. Providers/plugins are separate writers."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "openness"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$|^unavailable$" },
        "version": { "type": "string" },
        "openness": { "type": "string", "enum": ["open_source", "gray_box", "closed"] }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "status", "evidence"],
      "properties": {
        "class": { "type": "string", "enum": ["replay_native", "replay_adapted", "on_policy_only"] },
        "status": { "type": "string", "enum": ["pending", "admitted", "rejected"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native_write_path_preserved",
            "no_external_summarization_prompt",
            "ingestion_coverage_auditable",
            "native_lifecycle_preserved",
            "artifact_exportable",
            "repeat_run_coverage_consistent"
          ],
          "properties": {
            "native_write_path_preserved": { "type": "boolean" },
            "no_external_summarization_prompt": { "type": "boolean" },
            "ingestion_coverage_auditable": { "type": "boolean" },
            "native_lifecycle_preserved": { "type": "boolean" },
            "artifact_exportable": { "type": "boolean" },
            "repeat_run_coverage_consistent": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "model_snapshot", "reasoning_effort", "temperature", "retry_policy"],
      "properties": {
        "condition": { "type": "string", "enum": ["native_model", "matched_model", "none"] },
        "model_snapshot": { "type": "string" },
        "reasoning_effort": { "type": "string" },
        "temperature": { "type": ["number", "string"] },
        "max_output_tokens": { "type": "integer" },
        "retry_policy": { "type": "string" },
        "model_replaceable": { "type": "boolean" }
      }
    },
    "capacity_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports_budget"],
      "properties": {
        "supports_budget": { "type": "boolean" },
        "mechanism": { "type": "string", "description": "How the writer natively meets a token budget (config knob, consolidation trigger, ...)." },
        "budgets_declared": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "export_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "lossless"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "lossless": { "type": "boolean", "const": true },
        "acknowledged_by_upstream": { "type": "boolean" }
      }
    },
    "quiescence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "max_wait_seconds"],
      "properties": {
        "method": { "type": "string", "description": "Documented flush/shutdown/consolidation trigger used." },
        "max_wait_seconds": { "type": "integer", "minimum": 0 },
        "doc_ref": { "type": "string" }
      }
    },
    "memory_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "raw_transcript_is_memory"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "raw_transcript_is_memory": {
          "type": "boolean",
          "description": "true only if the system's own read path treats raw episodes as memory; then they are exported and tagged."
        }
      }
    },
    "config": { "type": "object" },
    "config_hash": { "type": "string" },
    "notes": { "type": "string" }
  }
}
