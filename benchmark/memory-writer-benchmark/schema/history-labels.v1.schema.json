{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-writer-benchmark.dev/schema/history-labels.v1.schema.json",
  "title": "MWB HistoryLabels v1",
  "description": "Hidden mapping from events to the state atoms they render. Used by artifact audit and certification only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["world_id", "spec_version", "renders"],
  "properties": {
    "world_id": { "type": "string", "pattern": "^world\\." },
    "spec_version": { "type": "string", "const": "0.1" },
    "renders": {
      "type": "object",
      "description": "event id -> list of state ids this event is evidence for (possibly indirect or misleading).",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^state\\." }
      }
    },
    "rendering_kind": {
      "type": "object",
      "description": "Optional per-event rendering kind for audit reports.",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "direct_statement",
          "indirect_hint",
          "correction",
          "reversal",
          "repeat",
          "third_party",
          "assistant_error",
          "tool_untrusted",
          "noise",
          "file_evidence"
        ]
      }
    }
  }
}
