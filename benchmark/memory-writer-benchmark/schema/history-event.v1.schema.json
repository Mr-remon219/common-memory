{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-writer-benchmark.dev/schema/history-event.v1.schema.json",
  "title": "MWB HistoryEvents v1",
  "description": "The replayable event stream every writer receives. Contains no hidden labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["world_id", "spec_version", "events"],
  "properties": {
    "world_id": { "type": "string", "pattern": "^world\\." },
    "spec_version": { "type": "string", "const": "0.1" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "session_id", "seq", "day", "role", "content"],
      "properties": {
        "id": { "type": "string", "pattern": "^ev\\.[a-z0-9_]+$" },
        "session_id": { "type": "string", "pattern": "^s[0-9]{2,3}$" },
        "seq": { "type": "integer", "minimum": 1, "description": "1-based order inside the session." },
        "day": { "type": "string", "pattern": "^day-[0-9]+$" },
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "tool", "file_change", "system_note"],
          "description": "system_note = benchmark-neutral environment note (e.g. 'new session started'); never carries instructions."
        },
        "tool_name": { "type": "string" },
        "path": { "type": "string", "description": "For file_change events: repository-relative path." },
        "content": { "type": "string", "minLength": 1 },
        "domain_hint": {
          "type": "string",
          "enum": ["coding", "project_building", "learning", "conversation"],
          "description": "Coarse surface domain of the session. Visible to writers because a real agent would also know which workspace it is in."
        }
      }
    }
  }
}
