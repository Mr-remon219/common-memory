{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-writer-benchmark.dev/schema/artifact-manifest.v1.schema.json",
  "title": "MWB ArtifactManifest v1 (Memory Artifact Interface)",
  "description": "Frozen, lossless export of one writer's persistent memory after quiescence. This is what the reader sees after canonical rendering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "writer_id",
    "world_id",
    "variant_id",
    "writer_seed",
    "snapshot",
    "ingestion_coverage",
    "records",
    "exclusions",
    "footprint",
    "serialization",
    "write_compute"
  ],
  "properties": {
    "spec_version": { "type": "string", "const": "0.1" },
    "writer_id": { "type": "string", "pattern": "^writer\\." },
    "world_id": { "type": "string", "pattern": "^world\\." },
    "variant_id": { "type": ["string", "null"], "pattern": "^variant\\." },
    "writer_seed": { "type": "integer" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "sha256", "quiescence"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash of the canonical rendering. Future tasks are sampled only after this hash exists." },
        "quiescence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "reached", "wait_seconds", "pending_jobs", "failed_jobs"],
          "properties": {
            "method": { "type": "string" },
            "reached": { "type": "boolean" },
            "wait_seconds": { "type": "number" },
            "pending_jobs": { "type": "integer", "minimum": 0 },
            "failed_jobs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ingestion_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events_total", "events_ingested", "sessions_total", "sessions_ingested"],
      "properties": {
        "events_total": { "type": "integer" },
        "events_ingested": { "type": "integer" },
        "sessions_total": { "type": "integer" },
        "sessions_ingested": { "type": "integer" },
        "missing_event_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "native_path", "native_type", "content"],
        "properties": {
          "record_id": { "type": "string" },
          "native_path": { "type": "string", "description": "File path, table/row locator, node id, etc. Used as primary sort key." },
          "native_type": {
            "type": "string",
            "enum": ["text_file", "markdown_file", "json_record", "yaml_record", "db_row", "graph_node", "graph_edge", "episode", "other"]
          },
          "tier": { "type": "string" },
          "trust_label": { "type": "string" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "native_metadata": { "type": "object", "description": "All native fields (confidence, salience, scope, provenance, supersession, links) verbatim, minus excluded classes." },
          "content": { "type": ["string", "object", "array"] }
        }
      }
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embeddings", "search_indexes", "caches", "transient_runtime_state", "hidden_chain_of_thought", "application_logs", "raw_history_copies"],
      "properties": {
        "embeddings": { "type": "boolean", "const": true },
        "search_indexes": { "type": "boolean", "const": true },
        "caches": { "type": "boolean", "const": true },
        "transient_runtime_state": { "type": "boolean", "const": true },
        "hidden_chain_of_thought": { "type": "boolean", "const": true },
        "application_logs": { "type": "boolean" },
        "raw_history_copies": { "type": "boolean", "description": "true = excluded. false only when writer-card.memory_surface.raw_transcript_is_memory=true." }
      }
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes_utf8", "tokens", "records", "files"],
      "properties": {
        "bytes_utf8": { "type": "integer", "minimum": 0 },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokenizer", "count"],
          "properties": {
            "tokenizer": { "type": "string", "const": "o200k_base", "description": "Pinned budget tokenizer for v0.1." },
            "count": { "type": "integer", "minimum": 0 }
          }
        },
        "records": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 }
      }
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "ordering", "lossless", "task_conditioned", "semantic_rewriting", "deduplication", "reranking"],
      "properties": {
        "renderer": { "type": "string", "const": "mwb-canonical-text/1" },
        "ordering": { "type": "string", "const": "native_path,record_id" },
        "lossless": { "type": "boolean", "const": true },
        "task_conditioned": { "type": "boolean", "const": false },
        "semantic_rewriting": { "type": "boolean", "const": false },
        "deduplication": { "type": "boolean", "const": false },
        "reranking": { "type": "boolean", "const": false }
      }
    },
    "write_compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_calls", "input_tokens", "output_tokens", "wall_seconds", "failures"],
      "properties": {
        "model_calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "wall_seconds": { "type": "number", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
