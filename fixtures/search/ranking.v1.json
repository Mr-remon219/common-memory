{
  "version": 1,
  "tokenizer": "trigram",
  "candidate_limit": 100,
  "bm25": { "best_rank": 1, "worst_rank": 0, "all_equal_rank": 1 },
  "boosts": {
    "exact_tag": 0.2,
    "exact_scope": 0.1,
    "priority": { "core": 0.15, "normal": 0.05, "archive": 0 },
    "temporal": 0.05,
    "provenance": { "user_correction": 0.06, "user_statement": 0.05, "project_evidence": 0.03, "imported_event": 0.02, "agent_observation": 0.01 }
  },
  "short_query": { "unicode_code_points_max": 2, "lexical_rank": 1 },
  "stable_tie_break": ["final_score DESC", "lexical_rank DESC", "fact_id ASC"]
}
